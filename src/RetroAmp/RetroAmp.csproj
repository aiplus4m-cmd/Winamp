<Project Sdk="Microsoft.NET.Sdk">
  <!--
    RetroAmp is written as "code-only" WPF (no XAML compilation) on .NET Framework 4.8,
    which ships with every Windows 10/11 install. This keeps the app tiny and lets it be
    built on any OS with the .NET SDK.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>RetroAmp</AssemblyName>
    <RootNamespace>RetroAmp</RootNamespace>
    <ApplicationIcon>..\..\assets\retroamp.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>1.1.0</Version>
    <Product>RetroAmp</Product>
    <Description>RetroAmp - a lightweight retro media player</Description>
    <Copyright>NhảmStudio · MIT License</Copyright>
    <Company>NhảmStudio</Company>
    <Authors>NhảmStudio</Authors>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <DebugType>embedded</DebugType>
    <NoWarn>$(NoWarn);CS0618;CS1591</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PresentationFramework" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\retroamp.ico" LogicalName="RetroAmp.icon.ico" />
    <EmbeddedResource Include="..\..\assets\nhamstudio-logo.png" LogicalName="RetroAmp.nhamstudio.png" />
  </ItemGroup>
</Project>
